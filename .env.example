# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Never commit .env.local.

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only — bypasses Row Level Security. Used for public questionnaire
# submissions (after token validation) and for the seed/admin scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Public base URL of the app (used for questionnaire links generated on the server)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only for `npm run db:migrate` (local). Supabase → Connect → "Session pooler".
# Replace [YOUR-PASSWORD] with the database password you chose.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
